; NPM configuration for publishing
; This file is used to configure npm publishing settings

; Use semantic versioning for tags
tag-version-prefix="v"

; Save exact versions (no caret/tilde)
save-exact=false

; Ensure package-lock.json is updated
save-prefix="^"

; Access level for the package
; Uncomment one of the following:
; For scoped public package (@org/package):
; access=public

; For unscoped public package:
access=public

; Registry URL (defaults to public npm registry)
registry=https://registry.npmjs.org/

; Optional: Configure GitHub Packages as well
; @alias:registry=https://npm.pkg.github.com

; Workspaces support (if needed)
; workspaces-update=true

{
  "name": "r-best-practices-mcp",
  "version": "0.8.5",
  "description": "MCP server for R development best practices - enforces standards across R scripts, Quarto, Shiny, packages, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "r-best-practices-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexseymer/r-best-practice-mcp.git"
  },
  "homepage": "https://github.com/alexseymer/r-best-practice-mcp#readme",
  "bugs": {
    "url": "https://github.com/alexseymer/r-best-practice-mcp/issues"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit --coverage",
    "test:all": "npm run test:unit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build && npm run test && npm run lint",
    "version": "npm run format && git add -A"
  },
  "keywords": [
    "mcp",
    "r-programming",
    "r-packages",
    "cran",
    "package-development",
    "testing",
    "devtools"
  ],
  "author": "alexseymer",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

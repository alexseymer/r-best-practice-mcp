{
  "name": "r-best-practices-mcp",
  "version": "1.0.0",
  "description": "MCP server for R development best practices - enforces standards across R scripts, Quarto, Shiny, packages, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "r-practices": "dist/bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexseymer/r-coding-mcp.git"
  },
  "homepage": "https://github.com/alexseymer/r-coding-mcp#readme",
  "bugs": {
    "url": "https://github.com/alexseymer/r-coding-mcp/issues"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:web": "node dist/web-server-entry.js",
    "dev": "npm run build && npm start",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --runInBand",
    "test:e2e": "jest tests/e2e --runInBand --testTimeout=120000",
    "test:load": "jest tests/performance --runInBand --testTimeout=60000",
    "test:examples": "jest tests/examples.test.ts",
    "test:regression": "jest tests/regression.test.ts",
    "test:all": "npm run test:unit && npm run test:examples && npm run test:regression && npm run test:load",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build && npm run test && npm run lint",
    "version": "npm run format && git add -A"
  },
  "keywords": [
    "mcp",
    "r-programming",
    "r-packages",
    "cran",
    "package-development",
    "testing",
    "devtools"
  ],
  "author": "alexseymer",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^11.0.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.0.0"
  }
}
